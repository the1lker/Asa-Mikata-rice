* {
    bg: #050505;
    bg-alt: #0d0d0d;
    bg-hover: #161616;

    fg: #eeeeee;
    fg-muted: #777777;

    border: #222222;
}

window {
    width: 650px;
    height: 500px;

    background-color: @bg;

    border: 1px;
    border-color: @border;
    border-radius: 16px;

    padding: 25px;

    location: center;
    anchor: center;

    children: [
        "inputbar",
        "listview"
    ];
}

inputbar {
    background-color: @bg-alt;

    border: 1px;
    border-color: @border;
    border-radius: 10px;

    padding: 12px 16px;
    margin: 0 0 18px 0;

    children: [
        "prompt",
        "entry"
    ];
}

prompt {
    background-color: transparent;
    text-color: @fg;
    padding: 0 10px 0 0;
}

entry {
    background-color: transparent;

    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @fg-muted;

    cursor: text;
}

listview {
    background-color: transparent;

    columns: 1;
    lines: 8;

    spacing: 6px;

    scrollbar: false;
    fixed-height: false;
}

element {
    background-color: transparent;

    border-radius: 10px;

    padding: 12px 16px;
    spacing: 12px;
}

element-text {
    background-color: transparent;

    text-color: @fg;

    vertical-align: 0.5;
}

element selected {
    background-color: @bg-hover;

    border: 1px;
    border-color: @border;
}

element selected element-text {
    text-color: #ffffff;
}
